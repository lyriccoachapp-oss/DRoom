# Copy to .env and fill in. Never commit .env.
# Key for the OpenAI API; photo render stays off without it.
OPENAI_API_KEY=
# Image model and quality (low, medium, high). Check the current model name in the OpenAI docs.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Photo renders allowed per visitor per hour.
RENDER_LIMIT_PER_HOUR=10
# Set to 1 only when the server sits behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=
PORT=8080
